# ─── database ──────────────────────────────────────────────────────────
# Neon pooled connection. Used by the app at runtime.
DATABASE_URL=

# Neon DIRECT (non-pooled) connection. Needed for `prisma migrate deploy`,
# which requires a session-level advisory lock the pooler cannot provide.
# NOTE: currently declared but not wired into the datasource — see fix #20.
DIRECT_URL=

# ─── secrets ───────────────────────────────────────────────────────────
# Master key for BYOK provider-key encryption (AES-256-GCM).
# Must be exactly 32 bytes, base64.   Generate:  openssl rand -base64 32
# The app will not start without this.
ENCRYPTION_KEY=

# Better Auth session signing.  Generate:  openssl rand -base64 32
# MUST be different in production from your dev value.
BETTER_AUTH_SECRET=

# Full origin of the deployment, e.g. https://graphchat.app
# Must be https in production or the session cookie ships without Secure.
BETTER_AUTH_URL=

# ─── oauth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── platform model access ─────────────────────────────────────────────
# Your OpenRouter key. This is what PLATFORM-source models bill against,
# so keep a hard monthly credit limit set in the OpenRouter dashboard.
OPENROUTER_API_KEY=

# ─── cron ──────────────────────────────────────────────────────────────
# Bearer token for /api/cron/*. Required in production — without it the
# endpoint fails closed (404) and the model catalog silently stops syncing.
CRON_SECRET=

# ─── model catalog sync (all optional) ─────────────────────────────────
# Used only by the 3-daily sync job to list each provider's models.
# A provider with no key here is skipped; nothing else breaks.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=